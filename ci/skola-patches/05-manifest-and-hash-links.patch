diff --git a/src/app/statistics/CardHistory.test.tsx b/src/app/statistics/CardHistory.test.tsx
new file mode 100644
index 0000000..29992fb
--- /dev/null
+++ b/src/app/statistics/CardHistory.test.tsx
@@ -0,0 +1,30 @@
+import { fireEvent, render, screen } from "@testing-library/react";
+import { HashRouter, Route, Routes } from "react-router-dom";
+import { expect, it } from "vitest";
+import CardHistory from "./CardHistory";
+
+it("keeps statistics navigation inside a GitHub Pages project path", async () => {
+  const previousUrl = window.location.href;
+  window.history.replaceState(null, "", "/skola/#/home");
+
+  try {
+    render(
+      <HashRouter>
+        <Routes>
+          <Route path="/home" element={<CardHistory />} />
+          <Route path="/stats" element={<h1>Statistics view</h1>} />
+        </Routes>
+      </HashRouter>
+    );
+
+    fireEvent.click(screen.getByRole("link", { name: "Statistics" }));
+
+    expect(
+      await screen.findByRole("heading", { name: "Statistics view" })
+    ).toBeInTheDocument();
+    expect(window.location.pathname).toBe("/skola/");
+    expect(window.location.hash).toBe("#/stats");
+  } finally {
+    window.history.replaceState(null, "", previousUrl);
+  }
+});
